<div class="container mt-4">
  <h2 class="mb-4 pb-2">Add a new restaurant: (New)</h2>
  <%= simple_form_for(@restaurant) do |f| %>
    <%= f.input :name %>
    <%= f.input :address %>
    <%= f.input :category, :collection => ["chinese", "italian", "japanese", "french", "belgian"] %>
    <%= f.submit "Create new restaurant", class: "btn btn-primary" %>
  <% end %>
</div>
