<div class="container mt-4">
  <h2 class="mb-4 pb-2">Restaurant Detail: (Show)</h2>
  <img src="https://api.sourcesplash.com/i/random?q=<%= @restaurant.name %>" class="w-100 object-fit-cover" style="height: 300px" alt="<%= @restaurant.category %> restaurant">
  <h2 class="my-4 pb-2"><%= @restaurant.name %></h2>
  <h3 class="mb-4 pb-2 border-bottom"><%= @restaurant.category.upcase %> Restaurant</h3>

  <p><strong>Reviews</strong></p>

  <div class="mb-4">
    <% @restaurant.reviews.each do |review| %>
      <div class="card mb-3 shadow-sm">
        <div class="card-body">

          <!-- Rating -->
          <h5 class="card-title">
            <span class="badge bg-warning text-dark">
              <%= review.rating %> ★
            </span>
          </h5>

          <!-- Content -->
          <p class="card-text mt-2">
            <%= review.content %>
          </p>

        </div>
      </div>
    <% end %>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm p-3">
        <h5 class="mb-4 pb-2">Add a new review for <%= @restaurant.name %>:</h5>

        <%= simple_form_for [@restaurant, @review] do |f| %>
          <%= f.input :rating, collection: [0, 1, 2, 3, 4, 5] %>
          <%= f.input :content %>
          <%= f.submit "Create new review", class: "btn btn-primary w-100" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="d-flex flex-column gap-2 mt-5">
    <%# <%= link_to "Add a new review", reviews_new_path(@restaurant.id), class: "btn btn-primary" %>
    <%= link_to "Back", restaurants_path, class: "btn btn-secondary" %>
  </div>
</div>
